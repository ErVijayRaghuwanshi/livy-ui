FROM apache/spark:4.1.2

USER root

# Install required Python packages for PySpark Declarative Pipelines (SDP), Spark Connect, and Data Science
RUN pip3 install --no-cache-dir \
    "pyyaml" \
    "pandas>=2.2.0" \
    "pyarrow>=15.0.0" \
    "grpcio>=1.48.1" \
    "protobuf<7.0.0" \
    "grpcio-status>=1.48.1" \
    "zstandard>=0.25.0" \
    "redis" \
    "neo4j"

# Copy pre-built livy-next binary with built-in CORS
COPY bin/livy-next /usr/local/bin/livy-next
RUN chmod +x /usr/local/bin/livy-next

# Copy Spark defaults configuration for packages and caching
COPY conf/spark-defaults.conf /opt/spark/conf/spark-defaults.conf

# Copy startup script
COPY start-spark.sh /opt/start-spark.sh
RUN chmod +x /opt/start-spark.sh && chown 185:185 /opt/start-spark.sh

# Create event logs directory
RUN mkdir -p /opt/spark/event_logs && chown -R 185:185 /opt/spark/event_logs /tmp

USER 185

ENV SPARK_HOME=/opt/spark
ENV PYSPARK_PYTHON=python3
ENV PYSPARK_DRIVER_PYTHON=python3
ENV SPARK_HISTORY_OPTS="-Dspark.history.fs.logDirectory=/opt/spark/event_logs -Dspark.history.ui.port=18080"

EXPOSE 7077 8080 18080 15002 8998

CMD ["/opt/start-spark.sh"]
